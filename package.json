{
  "name": "better-tg-cli",
  "version": "0.34.0",
  "description": "Telegram for your terminal and your AI agents: read, search, send and press bot buttons on your own account. MCP server included.",
  "mcpName": "io.github.TheVilfer/better-tg-cli",
  "keywords": [
    "telegram",
    "telegram-cli",
    "telegram-client",
    "mtproto",
    "cli",
    "terminal",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "llm",
    "claude",
    "claude-code",
    "cursor",
    "codex",
    "agent-skills"
  ],
  "homepage": "https://github.com/TheVilfer/better-tg-cli#readme",
  "bugs": {
    "url": "https://github.com/TheVilfer/better-tg-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheVilfer/better-tg-cli.git"
  },
  "license": "MIT",
  "author": {
    "name": "Sergei Polin",
    "url": "https://github.com/TheVilfer"
  },
  "contributors": [
    {
      "name": "Derek Rein",
      "url": "https://github.com/skillhq/telegram"
    }
  ],
  "type": "module",
  "bin": {
    "telegram": "dist/telegram.mjs"
  },
  "files": [
    "dist/telegram.mjs",
    "skills/better-tg-cli/SKILL.md",
    "skills/better-tg-cli/reference.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/gen-version.mjs && tsc --noEmit && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && bun scripts/bundle.mjs node",
    "prepublishOnly": "npm run build",
    "dev": "scripts/tg-dev",
    "dev:node": "TG_PROFILE=${TG_PROFILE-dev} TG_NO_UPDATE_CHECK=1 tsx src/index.ts",
    "dev:debug": "TG_PROFILE=${TG_PROFILE-dev} TG_NO_UPDATE_CHECK=1 tsx --inspect-brk src/index.ts",
    "dev:dist": "npm run build && TG_PROFILE=${TG_PROFILE-dev} TG_NO_UPDATE_CHECK=1 node dist/telegram.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest": "node scripts/gen-version.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "big-integer": "^1.6.52",
    "commander": "^15.0.0",
    "teleproto": "^1.229.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "uqr": "^0.1.3",
    "vitest": "^5.0.2"
  }
}
